void hc_pre(const Hc& p,cudaStream_t s){
    need(p.dim>0&&p.dim<=8192&&p.dim%4==0&&p.hc>0&&p.hc<=4&&
         p.n_mix==(2+p.hc)*p.hc&&p.previous_pre!=p.pre,"HIP fuse HC geometry/independent pre");
    strata_ds4_launch(hc_joint,p.n_mix+1,256,0,s,p);
}
void router(const float* W,const float* x,const float* bias,int n,int dim,int k,float scale,
    float* logits,int* idx,float* rw,unsigned* count,cudaStream_t s){
    need(n>0&&n<=1024&&dim>0&&dim%4==0&&k>0&&k<=kPicks&&k<=n,"HIP fuse router geometry");
    strata_ds4_launch(router_joint,(n+15)/16,512,0,s,W,x,bias,n,dim,k,scale,logits,idx,rw,count);
}
void ring(uint8_t* ring,uint16_t* ext,int64_t p0,int n,int d,cudaStream_t s){
    need(p0>=0&&n>0&&d>0&&d%32==0,"HIP fuse ring geometry");
    strata_ds4_launch(ring_joint,n,256,0,s,ring,ext,(long long)p0,n,d);
}
void attention(const float* q,const uint16_t* win,const void* ckv,const int* sel,int sel_stride,
    const AttnRows& ar,const float* sink,int heads,int dim,float scale,float* out,
    const AttnScratch& scr,float* scores,int score_stride,cudaStream_t s,const Finish* finish){
    const int total=ar.nwin[0]+ar.nsel[0];
    need(ar.gen==0&&dim==512&&heads>0&&ar.nwin[0]>=0&&ar.nsel[0]>=0&&ar.win0[0]>=0&&
         scr.rows&&scr.max_t>=1&&sel_stride>0&&sel_stride<=scr.cap&&ar.nsel[0]<=sel_stride&&
         score_stride>=total&&scores,"HIP fuse attention geometry/scratch");
    strata_ds4_launch(unpack_sel_kernel,dim3(cdiv(sel_stride,kStage),1),256,0,s,
        (const uint8_t*)ckv,sel,sel_stride,ar,scr.cap,scr.rows);
    if(total>0)strata_ds4_launch(score_rows,dim3(heads,cdiv(total,64)),256,0,s,q,win,scr.rows,ar,heads,scale,scores,score_stride);
    strata_ds4_launch((ordered_attention<true,0>),dim3(heads,1),256,0,s,win,scr.rows,
        sel,scr.cap,ar,sink,heads,dim,out,scores,score_stride,finish?*finish:Finish{},finish!=nullptr);
}
